# Forge CLI - npm ignore
# Only the dist/ directory should be published

# Source files
src/
*.ts
!dist/

# Test files
**/*.test.ts
**/*.test.js
**/*.test-d.ts

# Config files (keep in repo, not in package)
tsconfig.json
vitest.config.ts
eslint.config.js
.prettierrc
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Build artifacts (except dist)
coverage/
.nyc_output/

# Temporary
tmp/
temp/