{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@runforge/contracts": ["./packages/contracts/src/index.ts"],
      "@runforge/core": ["./packages/core/src/index.ts"],
      "@runforge/adapters": ["./packages/adapters/src/index.ts"],
      "@runforge/cli": ["./packages/cli/src/index.ts"]
    }
  }
}
